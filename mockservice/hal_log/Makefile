CXX = g++
CXXFLAGS = -fPIC -Wall -O2
LDFLAGS = -shared
TARGET = libhal_logger.so
SRCS = hal_logger.cpp
OBJS = $(SRCS:.cpp=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)