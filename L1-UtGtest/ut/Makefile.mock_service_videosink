.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

VIDEOSINK_SONAME := videosinkaidl
VIDEODECODER_SONAME := videodecoderaidl

MOCK_SERVICE_BIN := VideoSinkService
VIDEOSINK_LIB := lib$(VIDEOSINK_SONAME).so
VIDEODECODER_LIB := lib$(VIDEODECODER_SONAME).so

MOCK_SERVICE_DIR ?= $(HAL_DIR)/videosink_mock/src/service

BUILD_DIR ?= $(HAL_DIR)/build

AIDL_GEN_DIR ?= $(BUILD_DIR)/videosink_gen


COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/AVSource.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/HALError.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/PropertyValue.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/State.cpp


VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/Capabilities.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/IVideoSink.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/IVideoSinkController.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/IVideoSinkControllerListener.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/IVideoSinkEventListener.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/IVideoSinkManager.cpp
VIDEOSINK_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videosink/Property.cpp



VIDEODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Capabilities.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Codec.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/CodecCapabilities.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/DynamicRange.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/ErrorCode.cpp
VIDEODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/FrameMetadata.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoder.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderEventListener.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderController.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderControllerListener.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/OperationalMode.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/PixelFormat.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Property.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/ScanType.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/PropertyKVPair.cpp

MOCK_SERVICE_BIN_SRC += $(MOCK_SERVICE_DIR)/VideoSink.cpp
MOCK_SERVICE_BIN_SRC += $(MOCK_SERVICE_DIR)/VideoSinkService.cpp


MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib


MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(VIDEOSINK_LIB) $(VIDEODECODER_LIB)

$(VIDEODECODER_LIB): $(VIDEODECODER_GEN_SRC:%.cpp=%.o) $(COMMON_GEN_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $@ $(BUILD_DIR)/usr/lib

$(VIDEOSINK_LIB): $(VIDEODECODER_LIB)
$(VIDEOSINK_LIB): $(VIDEOSINK_LIB_SRC:%.cpp=%.o) $(COMMON_GEN_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS) \
		-l$(VIDEODECODER_SONAME)
	install $(VIDEOSINK_LIB) $(BUILD_DIR)/usr/lib



$(MOCK_SERVICE_BIN): $(VIDEODECODER_LIB) $(VIDEOSINK_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) -l$(VIDEOSINK_SONAME)
	install $(MOCK_SERVICE_BIN) $(BUILD_DIR)/usr/lib

# do not clash with `ut-core` by chaning the object file name to .o.1
%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@


